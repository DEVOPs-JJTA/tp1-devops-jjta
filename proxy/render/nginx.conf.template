events {
    worker_connections 1024;
}

http {
    server {
        listen ${PORT};

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 10s;
        # Los servicios Free pueden tardar cerca de un minuto en despertar.
        proxy_read_timeout 90s;
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 3;

        # Render comprueba el proxy sin despertar los otros servicios.
        location = /health {
            default_type application/json;
            return 200 '{"status":"OK","service":"proxy"}';
        }

        location /api/ {
            proxy_pass https://${API_HOST};
        }

        location / {
            proxy_pass https://${FRONTEND_HOST};
        }
    }
}
